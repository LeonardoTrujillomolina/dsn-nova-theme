  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class:python":                   { "foreground": "#C792EA" },
    "class.declaration:python":       { "foreground": "#C792EA", "bold": true },
    "class.defaultLibrary:python":    { "foreground": "#C792EA" },
    "type:python":                    { "foreground": "#C792EA" },
    "typeParameter:python":           { "foreground": "#C4B5FD" },
    "function:python":                { "foreground": "#58A6FF" },
    "function.declaration:python":    { "foreground": "#58A6FF", "bold": true },
    "function.defaultLibrary:python": { "foreground": "#60A5FA" },
    "method:python":                  { "foreground": "#58A6FF" },
    "method.declaration:python":      { "foreground": "#58A6FF", "bold": true },
    "method.defaultLibrary:python":   { "foreground": "#60A5FA" },
    "parameter:python":               { "foreground": "#C4B5FD" },
    "variable:python":                { "foreground": "#E2E8F0" },
    "variable.readonly:python":       { "foreground": "#00D4FF" },
    "variable.defaultLibrary:python": { "foreground": "#E2E8F0" },
    "property:python":                { "foreground": "#818CF8" },
    "property.readonly:python":       { "foreground": "#00D4FF" },
    "enum:python":                    { "foreground": "#A78BFA" },
    "enumMember:python":              { "foreground": "#FF6B35" },
    "namespace:python":               { "foreground": "#94A3B8" },
    "namespace.declaration:python":   { "foreground": "#94A3B8", "italic": true },
    "decorator:python":               { "foreground": "#FF6B35", "italic": true },
    "string:python":                  { "foreground": "#34D399" },
    "number:python":                  { "foreground": "#FF6B35" },
    "comment:python":                 { "foreground": "#4A6FA5" },
    "selfParameter:python":           { "foreground": "#94A3B8", "italic": true },
    "clsParameter:python":            { "foreground": "#94A3B8", "italic": true },
    "builtinConstant:python":         { "foreground": "#FF1744", "bold": true }
  },

  "tokenColors": [
    { "name": "Comments", "scope": "comment", "settings": { "foreground": "#4A6FA5" } },
    { "name": "Strings", "scope": "string", "settings": { "foreground": "#34D399" } },
    { "name": "Functions", "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#58A6FF" } },
    { "name": "Classes and types", "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type"], "settings": { "foreground": "#C792EA" } },
    { "name": "Parameters", "scope": "variable.parameter", "settings": { "foreground": "#C4B5FD" } },
    { "name": "Properties", "scope": "variable.other.property", "settings": { "foreground": "#818CF8" } },
    { "name": "Numbers", "scope": "constant.numeric", "settings": { "foreground": "#FF6B35" } },
    { "name": "Operators", "scope": "keyword.operator", "settings": { "foreground": "#94A3B8" } },
    { "name": "Keywords", "scope": "keyword", "settings": { "foreground": "#00D4FF" } },
    { "name": "Structural keywords", "scope": ["storage.type.function.python", "storage.type.class.python", "storage.modifier.async.python"], "settings": { "foreground": "#00D4FF", "fontStyle": "bold" } },
    { "name": "Decorators", "scope": ["entity.name.function.decorator.python", "punctuation.definition.decorator.python"], "settings": { "foreground": "#FF6B35", "fontStyle": "italic" } },
    { "name": "Self and cls", "scope": ["variable.parameter.function.language.special.self.python", "variable.parameter.function.language.special.cls.python"], "settings": { "foreground": "#94A3B8", "fontStyle": "italic" } },
    { "name": "Return and yield", "scope": ["keyword.control.flow.python", "keyword.control.flow.return.python", "keyword.control.flow.yield.python"], "settings": { "foreground": "#F43F5E" } },
    { "name": "None", "scope": "constant.language.none.python", "settings": { "foreground": "#F43F5E" } },
    { "name": "Booleans", "scope": "constant.language.boolean.python", "settings": { "foreground": "#FF6B35" } },
    { "name": "JSON keys", "scope": ["support.type.property-name.json", "support.type.property-name.json.comments"], "settings": { "foreground": "#00D4FF" } },
    { "name": "YAML keys", "scope": "entity.name.tag.yaml", "settings": { "foreground": "#818CF8" } },
    { "name": "Markdown headings", "scope": ["markup.heading.markdown", "entity.name.section.markdown"], "settings": { "foreground": "#F8FAFC", "fontStyle": "bold" } },
    { "name": "Markdown bold", "scope": "markup.bold.markdown", "settings": { "foreground": "#F8FAFC", "fontStyle": "bold" } },
    { "name": "Markdown italic", "scope": "markup.italic.markdown", "settings": { "foreground": "#C4B5FD", "fontStyle": "italic" } },
    { "name": "Markdown inline code", "scope": "markup.inline.raw.string.markdown", "settings": { "foreground": "#34D399" } },
    { "name": "Markdown links", "scope": ["markup.underline.link.markdown", "string.other.link.title.markdown"], "settings": { "foreground": "#58A6FF" } },
    { "name": "Dockerfile keywords", "scope": "keyword.other.special-method.dockerfile", "settings": { "foreground": "#00D4FF", "fontStyle": "bold" } }
  ]
}
